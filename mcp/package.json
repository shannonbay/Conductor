{
  "name": "@quarterdeck/mcp",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Task Tree MCP Server — persistent hierarchical task management for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../core",
    "build": "tsc",
    "predev": "npm run build --prefix ../core",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build --prefix ../core",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/install-hooks.mjs",
    "setup-hooks": "node scripts/install-hooks.mjs",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@quarterdeck/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "nanoid": "^5.0.7",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "bin": {
    "quarterdeck": "dist/cli.js"
  }
}
