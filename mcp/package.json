{
  "name": "@quarterdeck/mcp",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Quarterdeck MCP server: persistent goals for AI agents (bundled into the quarterdeck-goals plugin)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../core",
    "build": "tsc && node scripts/bundle.mjs",
    "predev": "npm run build --prefix ../core",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build --prefix ../core",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/install-hooks.mjs",
    "setup-hooks": "node scripts/install-hooks.mjs",
    "doctor": "node dist/cli.js doctor",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@quarterdeck/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "nanoid": "^5.0.7",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "esbuild": "0.27.4"
  },
  "bin": {
    "quarterdeck": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
